# OS/editor cruft — safe to ignore regardless of implementation language.
# The agent generating/regenerating an implementation should extend this
# file with language- and tool-specific entries (e.g. __pycache__/,
# node_modules/, .venv/) rather than replacing it.
.DS_Store
Thumbs.db
*.swp
.env
.env.local

# Python implementation/test artifacts.
__pycache__/
*.egg-info/
.pytest_cache/
.hypothesis/
.venv/

# TypeScript implementation/test artifacts.
node_modules/
dist/
coverage/

# Rust implementation/test artifacts.
target/
